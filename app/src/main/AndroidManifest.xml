<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Phase A12 — Key-expiration reminders.
      • POST_NOTIFICATIONS is the runtime permission required on
        API 33+ to display notifications. On older APIs notifications
        post freely (subject to the per-app toggle in System Settings).
      • RECEIVE_BOOT_COMPLETED lets BootReceiver re-schedule alarms
        after device reboot — Android wipes alarms during boot, so
        without this declaration the reminders silently stop working
        after the user's first restart.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      HW Phase 1 — NFC hardware-key (OpenPGP card) support.
      NFC lets PGPony talk to YubiKey 5 / Token2 PIN+ / Nitrokey 3 over
      the air via ISO 7816-4 APDUs (IsoDep). required="false" so the app
      still installs on NFC-less devices — the hardware-key UI is simply
      hidden / shows an "NFC unavailable" message there.
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!--
      4.1.0 USB Phase 1 — wired OpenPGP cards over USB/OTG.
      required="false" so the app still installs on devices with no USB host
      support; the USB affordances are simply absent there, the same posture
      as NFC above.

      No ACTION_USB_DEVICE_ATTACHED filter on purpose. Launching PGPony when a
      key is plugged in would put another PGPony entry in front of the user,
      and issue #6 exists because there are already too many. Attached readers
      are detected while the app is open instead.

      No permission element either: USB device access is granted per-device at
      runtime through UsbManager, not declared here.
    -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!--
      4.0.0 Phase 6 — Orbot detection. Android 11+ package visibility
      requires declaring a package before queryable. We only READ whether
      Orbot is installed (to offer the one-tap SOCKS default); no
      interaction beyond that.
    -->
    <queries>
        <package android:name="org.torproject.android" />
    </queries>
    <application
        android:name=".PGPonyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="PGPony"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PGPony"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection"
            android:theme="@style/Theme.PGPony">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              4.1.0 Phase 7b — the SEND text/plain and typed-PGP SEND
              filters, and the whole VIEW set bar .pgpony, are GONE from
              here. ShareTargetActivity registers every one of them, so
              declaring them twice put two PGPony entries in front of the
              user for a single share, which is what the A15 comment below
              anticipated and what reporters have been picking the wrong
              one of.

              The share target reaches the main app by EXPLICIT intent
              where it needs to — a forwarded public key arrives as
              ACTION_SEND text/plain, a detached signature as
              ACTION_VERIFY_DETACHED — and an explicit intent needs no
              filter, so nothing above depended on these being declared.
            -->
            <!-- 4.1.0 Phase 7b — this filter existed (3.1.0 Phase 1 Fix2)
                 because the Quick Action had no verify route, so a shared
                 detached signature needed the main app to be offered as a
                 second chooser entry. Fix3 in the same release removed the
                 reason: ShareTargetActivity now recognises a detached
                 signature and forwards it to MainActivity's Verify-a-file
                 sheet itself. The second entry has been redundant ever
                 since, and the pgp-signature type moved up to the share
                 target's own typed filter. -->
            <!-- 3.1.0 Phase 6 (J5) — share two or more files of ANY type
                 into PGPony to encrypt them together as one Bundle
                 (mirrors iOS PGPonyAction's raised activation cap). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 4.1.0 Phase 7b — the PGP-MIME VIEW filter is gone; it was
                 identical to ShareTargetActivity's, which is why tapping a
                 .asc offered a choice of two PGPonys. -->
            <!--
              4.1.0 Phase 7b — what is left of MainActivity's file:// VIEW
              filter: .pgpony and nothing else.

              A .pgpony is an encrypted keyring backup and opens to Restore
              (IntentHandler → IntentAction.RestoreBackup → BackupScreen).
              That flow exists only in the main app; ShareTargetActivity has
              no restore phase and has never registered .pgpony, so this was
              not a duplicate and must not be swept up with the ones that
              were. The .asc/.pgp/.gpg/.sig/.eml patterns WERE duplicates
              and have gone.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:host="*" />
                <!-- 4.0.0 Phase 3 — encrypted keyring backup opens to Restore -->
                <data android:pathPattern=".*\\.pgpony" />
            </intent-filter>
            <!--
              4.1.0 Phase 7b — same trim on the content:// side, and the
              one that matters most in practice: DocumentsUI, Drive and
              OneDrive all hand over content:// URIs, so this is the filter
              a tap actually goes through on a modern device.

              Both mimeTypes are kept because a .pgpony can arrive typed
              either way, and the path pattern is what keeps PGPony out of
              the chooser for every text file on the device — see the 4.0.4
              note that used to live here, now on ShareTargetActivity's copy
              of this filter, which retains the full pattern list.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <!-- 4.0.0 Phase 3 — encrypted keyring backup opens to Restore -->
                <data android:pathPattern=".*\\.pgpony" />
            </intent-filter>
        </activity>

        <!--
          Phase A15 — Rich share-target / Quick Action activity.

          ShareTargetActivity is the iOS PGPonyAction extension equivalent
          on Android: a standalone activity that lets the user encrypt or
          decrypt a shared blob without having to launch the full app.

          Why a separate activity (not just routing through MainActivity):

            * Independent task affinity (android:taskAffinity="") means
              dismissing it returns the user to the source app — not into
              PGPony's main task stack. iOS Action Extensions behave the
              same way: dismissing returns to Mail/Notes/etc., not to
              the host app.

            * launchMode="singleTop" so a second share while one Quick
              Action is open reuses the existing activity instance via
              onNewIntent — the user does not stack multiple share UIs.

            * exported="true" because the intent filters below need to
              be reachable from any source app on the device. Required
              by Android 12+ (API 31) when the activity declares any
              intent filter.

          About the duplicate intent filters with MainActivity:

            DONE, 4.1.0 Phase 7b. They are removed. MainActivity now
            declares only what this activity does NOT: MAIN/LAUNCHER,
            SEND_MULTIPLE (the bundle entry point, which was never
            registered here) and VIEW for .pgpony (keyring restore, which
            has no share-target equivalent). Everything a share or a tap
            can offer twice, it no longer does.

            The reason the note above hedged — "once we are confident no
            existing install relies on them" — resolved on its own: the
            main app is reached by EXPLICIT intent from here for the two
            cases that need it, key forwarding and detached-signature
            verification, and an explicit intent does not consult filters.

            One consequence to expect on upgrade: a user who ticked
            "Always" against the main-app entry loses that association,
            because the filter it was recorded against is gone. The next
            share picks the Quick Action with no chooser rather than
            failing, which is the intended destination anyway.

          On the share targets we register:

            * ACTION_SEND text/plain — typical "share to PGPony" from
              a notes app, email body, browser, etc.
            * ACTION_SEND with any MIME — file shares (encrypted files,
              key files). We let the activity classify what the user
              actually sent.
            * ACTION_VIEW application/pgp-encrypted | pgp-keys — the
              canonical PGP MIME types when a file manager opens an
              .asc / .pgp / .gpg directly.
            * ACTION_VIEW file:// + path patterns — fallback for file
              managers that don't bother setting the MIME type and
              just hand us a file URI with a recognizable extension.
            * ACTION_VIEW content:// application/octet-stream + path
              patterns — DocumentsUI / Drive / OneDrive on Android
              hand a content URI with octet-stream MIME, and the
              path-pattern is the only signal we have.
        -->
        <activity
            android:name=".ui.share.ShareTargetActivity"
            android:exported="true"
            android:label="@string/share_target_activity_label"
            android:theme="@style/Theme.PGPony"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="false">
            <!-- Receive plain text for encrypt / decrypt -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Receive any file via Share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pgp-encrypted" />
                <data android:mimeType="application/pgp-keys" />
                <data android:mimeType="application/octet-stream" />
                <!-- 4.1.0 Phase 7b — these two came off MainActivity's
                     typed SEND filter when the duplicates were removed.
                     Both would still have matched the SEND */* filter
                     below, but a wildcard match and a typed match differ
                     in priority and in the label the chooser shows, so
                     they are declared rather than left to fall through.
                     pgp-signature in particular is how providers type a
                     shared .sig, and the share target forwards those to
                     MainActivity's Verify-a-file sheet. -->
                <data android:mimeType="application/pgp-signature" />
                <data android:mimeType="message/rfc822" />
            </intent-filter>
            <!-- Phase A2 — accept ANY file type shared for encryption (PDF,
                 image, zip, etc.). Additive: the specific filters above keep
                 their priority for PGP types; this broadens ingestion so a
                 user can Share → PGPony from any app to encrypt a file. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Receive .asc/.pgp/.gpg via Open / View -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pgp-encrypted" />
                <data android:mimeType="application/pgp-keys" />
                <!-- 3.1.0 Phase 1 Fix1 — .asc/.sig are commonly typed
                     application/pgp-signature by providers; without this
                     they can't be tap-opened, only shared. -->
                <data android:mimeType="application/pgp-signature" />
                <!-- 3.1.0 Phase 4 (J2) — encrypted .eml from desktop
                     clients opens into the decrypt path. -->
                <data android:mimeType="message/rfc822" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.asc" />
                <data android:pathPattern=".*\\.pgp" />
                <data android:pathPattern=".*\\.gpg" />
                <!-- 3.1.0 Phase 1 (C1) -->
                <data android:pathPattern=".*\\.sig" />
                <!-- 3.1.0 Phase 4 (J2) -->
                <data android:pathPattern=".*\\.eml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <!-- 4.0.4 (origin: Meino) — armored keys and signatures are
                     plain text, and plenty of providers type them exactly
                     that way, which left tap-to-open with no matching
                     filter at all. Deliberately kept inside THIS filter
                     rather than given its own: the path patterns below
                     apply to every mimeType listed here, so PGPony offers
                     itself for a text/plain .asc but NOT for every .txt on
                     the device. A bare text/plain VIEW filter would put us
                     in the chooser for every text file the user opens. -->
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.asc" />
                <data android:pathPattern=".*\\.pgp" />
                <data android:pathPattern=".*\\.gpg" />
                <!-- 3.1.0 Phase 1 (C1) -->
                <data android:pathPattern=".*\\.sig" />
                <!-- 3.1.0 Phase 4 (J2) -->
                <data android:pathPattern=".*\\.eml" />
            </intent-filter>
        </activity>
        <!--
          Phase A7 Fix3 — FileProvider for sharing exported .asc files.

          Authority is namespaced with applicationId so it's globally
          unique even if a future fork of this app installs alongside.
          android:exported="false" means external apps can't enumerate
          our files; they can only access URIs we explicitly grant
          via FLAG_GRANT_READ_URI_PERMISSION in the share Intent.
          grantUriPermissions="true" enables those Intent-level grants.
          Path configuration in res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Phase A12 — Key-expiration reminders.

          KeyExpirationReceiver is the alarm trigger that posts the
          notification when an AlarmManager wake-up fires for a
          (key, daysBefore) pair scheduled by KeyExpirationService.
          android:exported="false" because only AlarmManager (via our
          own PendingIntent) ever invokes it; external apps have no
          business poking at our reminder schedule.

          BootReceiver listens for BOOT_COMPLETED and re-schedules
          alarms (Android wipes alarms during boot). android:exported
          is true because BOOT_COMPLETED is a protected system
          broadcast that only ships from the OS itself — and the
          system requires exported=true to deliver to us. The
          intent-filter scopes which broadcasts we accept; without
          it the receiver is unreachable.
        -->
        <receiver
            android:name=".notifications.KeyExpirationReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          A14 Picker — AppLocalesMetadataHolderService.

          Required service declaration for AppCompat's per-app language
          preferences to persist correctly on API 26–32. On API 33+ the
          system handles persistence via LocaleManager (and ignores this
          service), but we declare it unconditionally because the
          androidx.appcompat library expects it to be present and warns
          at startup otherwise.

          The service is implemented entirely inside the AppCompat
          library — we don't subclass or override anything. android:enabled
          is false because the service has no work to do at runtime;
          AppCompat reads only the manifest declaration as metadata.
          android:exported is false because nothing outside our process
          should be invoking it.
        -->
        <!--
          4.0.0 Succession Phase 1 — OpenPGP API provider service.

          The exported crypto-provider surface that makes PGPony
          selectable in Thunderbird for Android / K-9 Mail / Password
          Store / Conversations. Clients discover providers by
          resolving the org.openintents.openpgp.IOpenPgpService2
          action, bind, and call execute() over AIDL.

          exported=true is REQUIRED — the entire point is that other
          apps bind to it. The security boundary is NOT the manifest;
          it is the signature-pinned per-package allow-list enforced
          inside the service on every call (ApiClientAuthorizer, plan
          §5: no default-allow, first-use consent, revocation UI in
          Settings → Connected apps).

          Only the IOpenPgpService2 action is registered (API versions
          7–12; see supportedApiVersions in PGPonyOpenPgpService, which is
          the value actually enforced). The obsolete v1
          IOpenPgpService action is deliberately absent: registering
          it would advertise an interface we do not implement to
          ancient clients.
        -->
        <service
            android:name=".provider.PGPonyOpenPgpService"
            android:process=":remote_api"
            android:exported="true">
            <intent-filter>
                <action android:name="org.openintents.openpgp.IOpenPgpService2" />
            </intent-filter>
        </service>

        <!--
          4.0.0 Succession Phase 1 — first-use consent dialog for API
          clients. NOT exported: it is only ever launched through the
          PendingIntent the provider service returns with
          RESULT_CODE_USER_INTERACTION_REQUIRED, so external apps
          cannot open it directly (a PendingIntent carries OUR
          identity, which is what makes the non-exported launch work).
          Presents as a dialog-first screen (Compose AlertDialog over
          the app theme); excludeFromRecents so a half-finished
          consent never lingers in the app switcher.
        -->
        <activity
            android:name=".provider.ApiConsentActivity"
            android:process=":remote_api"
            android:exported="false"
            android:theme="@style/Theme.PGPony"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!--
          4.0.0 Succession Phase P2a-1 — signing-key picker for API
          clients (Thunderbird's "Configure end-to-end key"). Same
          posture as the consent activity: NOT exported, reachable only
          via the PendingIntent attached to GET_SIGN_KEY_ID responses.
        -->
        <activity
            android:name=".provider.ProviderKeyPickerActivity"
            android:process=":remote_api"
            android:exported="false"
            android:theme="@style/Theme.PGPony"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!--
          4.0.0 Succession Phase P2a-2 — passphrase prompt for provider
          operations on a protected signing key. Same posture: NOT
          exported, PendingIntent-only. The passphrase goes into the
          in-process ProviderPassphraseCache, never back to the client.
        -->
        <activity
            android:name=".provider.ProviderPassphraseActivity"
            android:process=":remote_api"
            android:exported="false"
            android:theme="@style/Theme.PGPony"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!--
          4.0.0 Succession Phase P2c — hardware-card operation surface
          for API clients: NFC scan + PIN, with the whole crypto
          operation running during the tap. Same posture as the other
          provider activities: NOT exported, PendingIntent-only.
        -->
        <activity
            android:name=".provider.ProviderCardOpActivity"
            android:process=":remote_api"
            android:exported="false"
            android:theme="@style/Theme.PGPony"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
